[Desktop Entry]
Version=1.0
Type=Application
Name=Zed
GenericName=Text Editor
Comment=A high-performance, multiplayer code editor.
TryExec=/run/current-system/sw/bin/nvidia-offload
StartupNotify=true
Exec=/run/current-system/sw/bin/nvidia-offload /run/current-system/sw/bin/zeditor %U
Icon=zed
Categories=Utility;TextEditor;Development;IDE;
Keywords=zed;
MimeType=text/plain;application/x-zerosize;x-scheme-handler/zed;
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Exec=/run/current-system/sw/bin/nvidia-offload /run/current-system/sw/bin/zeditor --new %U
Name=Open a new workspace
