diff --git a/internal/adapters/system/git_remote.go b/internal/adapters/system/git_remote.go
--- /dev/null
+++ b/internal/adapters/system/git_remote.go
@@ -0,0 +1,117 @@
+package system
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+
+	"github.com/permgps/herdr-telegram-agents/internal/domain"
+)
+
+// remoteDiff reads the local side of the upstream merge base, then appends
+// patches for untracked, non-ignored files. It never stages files, writes
+// objects, fetches, or enters nested repositories.
+func (r *GitRunner) remoteDiff(ctx context.Context, dir string) (domain.GitResult, error) {
+	bin, err := exec.LookPath(r.bin)
+	if err != nil {
+		return domain.GitResult{}, domain.ErrGitMissing
+	}
+	ctx, cancel := context.WithTimeout(ctx, r.timeout)
+	defer cancel()
+	filters, err := r.filters(ctx, bin, dir)
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	query := func(where string, args []string, limit int, difference bool) ([]byte, bool, error) {
+		cmd := r.command(ctx, bin, where, gitArgv(args, filters))
+		stdout := &limitedWriter{max: limit}
+		var stderr bytes.Buffer
+		cmd.Stdout, cmd.Stderr = stdout, &stderr
+		err := cmd.Run()
+		if ctx.Err() != nil {
+			return nil, false, ctx.Err()
+		}
+		var exit *exec.ExitError
+		if err == nil || stdout.capped || difference && errors.As(err, &exit) && exit.ExitCode() == 1 {
+			return stdout.buf.Bytes(), stdout.capped, nil
+		}
+		if strings.Contains(stderr.String(), "not a git repository") {
+			return nil, false, domain.ErrNotRepository
+		}
+		return nil, false, fmt.Errorf("git %s: %w: %s", args[0], err, firstLine(stderr.String()))
+	}
+	resolve := func(where string, args ...string) (string, error) {
+		out, capped, err := query(where, args, gitMaxProbe, false)
+		if capped {
+			return "", fmt.Errorf("git reference output exceeded the limit")
+		}
+		return strings.TrimSuffix(string(out), "\n"), err
+	}
+	root, err := resolve(dir, "rev-parse", "--show-toplevel")
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	upstream, err := resolve(root, "rev-parse", "--verify", "@{upstream}")
+	if err != nil {
+		// Colocated Jujutsu repositories commonly leave HEAD detached.
+		// Their configured remote default is the explicit comparison base.
+		_, headErr := resolve(root, "symbolic-ref", "--quiet", "HEAD")
+		var exit *exec.ExitError
+		if errors.As(headErr, &exit) && exit.ExitCode() == 1 {
+			upstream, err = resolve(root, "rev-parse", "--verify", "refs/remotes/origin/HEAD")
+		}
+	}
+	if err != nil {
+		return domain.GitResult{}, fmt.Errorf("remote base is unavailable; configure upstream, or origin/HEAD for detached HEAD, on the computer: %w", err)
+	}
+	base, err := resolve(root, "merge-base", "HEAD", upstream)
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	tracked, capped, err := query(root, []string{"diff", base, "--"}, r.maxBytes, false)
+	if err != nil || capped {
+		return domain.GitResult{Output: string(tracked), Truncated: capped}, err
+	}
+	var patch bytes.Buffer
+	patch.Write(tracked)
+	paths, listingCapped, err := query(root, []string{"ls-files", "--others", "--exclude-standard", "-z"}, gitMaxOutput, false)
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	if listingCapped {
+		paths = paths[:bytes.LastIndexByte(paths, 0)+1]
+	}
+	for _, file := range strings.Split(string(paths), "\x00") {
+		if file == "" {
+			continue
+		}
+		// ls-files may name an untracked nested repository as a directory.
+		info, err := os.Lstat(root + "/" + file)
+		if os.IsNotExist(err) {
+			continue // changed between the listing and the read
+		}
+		if err != nil {
+			return domain.GitResult{}, err
+		}
+		if !info.Mode().IsRegular() && info.Mode()&os.ModeSymlink == 0 {
+			continue
+		}
+		remaining := r.maxBytes - patch.Len()
+		if remaining <= 0 {
+			return domain.GitResult{Output: patch.String(), Truncated: true}, nil
+		}
+		out, capped, err := query(root, []string{"diff", "--no-index", "--", os.DevNull, "./" + file}, remaining, true)
+		if err != nil {
+			return domain.GitResult{}, err
+		}
+		patch.Write(out)
+		if capped {
+			return domain.GitResult{Output: patch.String(), Truncated: true}, nil
+		}
+	}
+	return domain.GitResult{Output: strings.TrimRight(patch.String(), "\n"), Truncated: listingCapped}, nil
+}
