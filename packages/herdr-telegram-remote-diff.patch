+package domain_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/permgps/herdr-telegram-agents/internal/domain"
+)
+
+func TestParseGitRemote(t *testing.T) {
+	spec, ok := domain.ParseGit([]string{"diff", "remote"})
+	if !ok || spec.Sub != "diff" || !reflect.DeepEqual(spec.Args, []string{"diff", "--merge-base", "@{upstream}", "--"}) {
+		t.Fatalf("remote diff = %+v, %v", spec, ok)
+	}
+	for _, args := range [][]string{{"diff", "remote", "--fetch"}, {"diff", "origin/main"}, {"diff", "remote", "/tmp/file"}} {
+		if _, ok := domain.ParseGit(args); ok {
+			t.Fatalf("accepted arbitrary arguments: %v", args)
+		}
+	}
+}
