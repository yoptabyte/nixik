+package app
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/permgps/herdr-telegram-agents/internal/domain"
+)
+
+func TestInboundGitRemoteAsDocument(t *testing.T) {
+	f := newBridgeFixture(t)
+	gitAgent(t, f)
+	text := strings.Repeat("+local change\n", 400)
+	f.git.SetResult(domain.GitResult{Output: text})
+	if err := f.in.HandleTopic(f.ctx, topicMsg(101, 7, "/git diff remote")); err != nil {
+		t.Fatal(err)
+	}
+	calls := f.git.Calls()
+	if len(calls) != 1 || strings.Join(calls[0].Args, " ") != "diff --merge-base @{upstream} --" {
+		t.Fatalf("unexpected git request: %+v", calls)
+	}
+	docs := f.tg.Documents()
+	if len(docs) != 1 || !strings.HasSuffix(docs[0].Name, ".patch") || string(docs[0].Data) != text ||
+		!strings.Contains(docs[0].Caption, "includes untracked") || !strings.Contains(docs[0].Caption, "last fetch") {
+		t.Fatal("missing complete patch or upstream caption")
+	}
+}
