@@ -0,0 +1,172 @@
+package system
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/permgps/herdr-telegram-agents/internal/domain"
+)
+
+var remoteDiffArgs = []string{"diff", "--merge-base", "@{upstream}", "--"}
+
+func TestGitRemoteDiffIncludesAllLocalChangesAndPreservesIndex(t *testing.T) {
+	dir := gitRepo(t)
+	run := func(args ...string) []byte {
+		t.Helper()
+		cmd := exec.Command("git", args...)
+		cmd.Dir = dir
+		cmd.Env = append(os.Environ(), "GIT_AUTHOR_NAME=t", "GIT_AUTHOR_EMAIL=t@example.com",
+			"GIT_COMMITTER_NAME=t", "GIT_COMMITTER_EMAIL=t@example.com", "GIT_CONFIG_NOSYSTEM=1", "HOME="+dir)
+		out, err := cmd.CombinedOutput()
+		if err != nil {
+			t.Fatalf("git %v: %v: %s", args, err, out)
+		}
+		return out
+	}
+	write := func(name, text string) {
+		t.Helper()
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(text), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	run("branch", "upstream")
+	run("checkout", "-q", "upstream")
+	write("remote-only.txt", "REMOTE_ONLY_MUST_NOT_APPEAR\n")
+	run("add", "remote-only.txt")
+	run("commit", "-q", "-m", "remote changes")
+	run("checkout", "-q", "main")
+	run("config", "branch.main.remote", ".")
+	run("config", "branch.main.merge", "refs/heads/upstream")
+	write("a.txt", "one\nLOCAL_COMMIT\n")
+	run("add", "a.txt")
+	run("commit", "-q", "-m", "not pushed")
+	write("a.txt", "one\nLOCAL_COMMIT\nSTAGED_CHANGE\n")
+	run("add", "a.txt")
+	write("a.txt", "one\nLOCAL_COMMIT\nSTAGED_CHANGE\nUNSTAGED_CHANGE\n")
+	write("--new file.txt", "UNTRACKED_CHANGE\n")
+	write(".gitignore", "ignored.txt\n")
+	write("ignored.txt", "IGNORED_MUST_NOT_APPEAR\n")
+	external := filepath.Join(t.TempDir(), "outside")
+	if err := os.WriteFile(external, []byte("OUTSIDE_CONTENT_MUST_NOT_APPEAR"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(external, filepath.Join(dir, "link")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(filepath.Join(dir, "subdir"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	beforeStatus := run("status", "--porcelain")
+	beforeIndex, err := os.ReadFile(filepath.Join(dir, ".git", "index"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := NewGitRunner(nil)
+	res, err := r.Run(context.Background(), filepath.Join(dir, "subdir"), remoteDiffArgs)
+	if err != nil || res.Truncated {
+		t.Fatalf("remote diff: %+v, %v", res, err)
+	}
+	for _, want := range []string{"LOCAL_COMMIT", "STAGED_CHANGE", "UNSTAGED_CHANGE", "UNTRACKED_CHANGE"} {
+		if !strings.Contains(res.Output, want) {
+			t.Errorf("missing %s", want)
+		}
+	}
+	for _, unwanted := range []string{"REMOTE_ONLY_MUST_NOT_APPEAR", "IGNORED_MUST_NOT_APPEAR", "OUTSIDE_CONTENT_MUST_NOT_APPEAR"} {
+		if strings.Contains(res.Output, unwanted) {
+			t.Errorf("unexpected content: %s", unwanted)
+		}
+	}
+	afterIndex, err := os.ReadFile(filepath.Join(dir, ".git", "index"))
+	if err != nil || !bytes.Equal(beforeIndex, afterIndex) {
+		t.Fatalf("real index changed: %v", err)
+	}
+	if !bytes.Equal(beforeStatus, run("status", "--porcelain")) {
+		t.Fatal("working tree or staging state changed")
+	}
+	r.maxBytes = 40
+	limited, err := r.Run(context.Background(), dir, remoteDiffArgs)
+	if err != nil || !limited.Truncated || len(limited.Output) > 40 {
+		t.Fatalf("output cap: %+v, %v", limited, err)
+	}
+}
+
+func TestGitRemoteDiffMissingUpstream(t *testing.T) {
+	dir := gitRepo(t)
+	_, err := NewGitRunner(nil).Run(context.Background(), dir, remoteDiffArgs)
+	if err == nil || !strings.Contains(err.Error(), "upstream") {
+		t.Fatalf("missing upstream: %v", err)
+	}
+}
+
+func TestGitRemoteDiffDetachedHeadUsesRemoteDefault(t *testing.T) {
+	dir := gitRepo(t)
+	for _, args := range [][]string{
+		{"update-ref", "refs/remotes/origin/main", "HEAD"},
+		{"symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/main"},
+		{"checkout", "--detach", "-q"},
+	} {
+		cmd := exec.Command("git", args...)
+		cmd.Dir = dir
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v: %s", args, err, out)
+		}
+	}
+	res, err := NewGitRunner(nil).Run(context.Background(), dir, remoteDiffArgs)
+	if err != nil || !strings.Contains(res.Output, "+two") {
+		t.Fatalf("detached repository diff: %+v, %v", res, err)
+	}
+}
+
+func TestGitRemoteDiffMissingBinary(t *testing.T) {
+	r := NewGitRunner(nil)
+	r.bin = "no-such-git-command"
+	_, err := r.Run(context.Background(), t.TempDir(), remoteDiffArgs)
+	if err != domain.ErrGitMissing {
+		t.Fatalf("missing git: %v", err)
+	}
+}
+
+func TestGitRemoteDiffDoesNotRunRepositoryPrograms(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("Unix script fixture")
+	}
+	dir := gitRepo(t)
+	configure := func(args ...string) {
+		t.Helper()
+		cmd := exec.Command("git", args...)
+		cmd.Dir = dir
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v: %s", args, err, out)
+		}
+	}
+	configure("branch", "upstream")
+	configure("config", "branch.main.remote", ".")
+	configure("config", "branch.main.merge", "refs/heads/upstream")
+	marker := filepath.Join(t.TempDir(), "ran")
+	script := filepath.Join(t.TempDir(), "hook")
+	if err := os.WriteFile(script, []byte("#!/bin/sh\necho ran > "+marker+"\n"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"core.fsmonitor", "diff.external", "diff.evil.textconv", "filter.evil.clean", "filter.evil.process"} {
+		configure("config", key, script)
+	}
+	if err := os.WriteFile(filepath.Join(dir, ".gitattributes"), []byte("*.txt diff=evil filter=evil\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "new.txt"), []byte("new text\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	res, err := NewGitRunner(nil).Run(context.Background(), dir, remoteDiffArgs)
+	if err != nil || !strings.Contains(res.Output, "new text") {
+		t.Fatalf("safe remote diff: %+v, %v", res, err)
+	}
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatal("a repository-defined program ran")
+	}
+}
