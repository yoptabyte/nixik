+func (r *Reader) transcript(ctx context.Context, agent domain.Agent, dir string) (string, time.Time, int, error) {
+	if r.session == nil || agent.SessionDigest == "" {
+		return newestTranscript(dir)
+	}
+	tuple, err := r.session(ctx, agent.PaneID)
+	if err != nil {
+		return "", time.Time{}, 0, classifySessionError(ctx, err, "claude session lookup failed")
+	}
+	if err := ctx.Err(); err != nil {
+		return "", time.Time{}, 0, err
+	}
+	if tuple.Agent != kindClaude || tuple.Kind != "id" || tuple.Digest() != agent.SessionDigest || !codexThreadID.MatchString(tuple.Value) {
+		return "", time.Time{}, 0, fmt.Errorf("%w: claude session identity unavailable or changed", domain.ErrNoReply)
+	}
+	path := filepath.Join(dir, tuple.Value+transcriptSuffix)
+	info, err := os.Lstat(path)
+	if err != nil || !info.Mode().IsRegular() {
+		return "", time.Time{}, 0, fmt.Errorf("%w: claude session transcript unavailable", domain.ErrNoReply)
+	}
+	return path, info.ModTime(), 1, nil
+}
