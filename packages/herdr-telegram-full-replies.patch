+func TestClaudeExactSessionIgnoresNewerSibling(t *testing.T) {
+	home := t.TempDir()
+	cwd := "/project"
+	tuple := domain.SessionTuple{Source: "herdr:claude", Agent: "claude", Kind: "id", Value: "12345678-1234-4234-8234-123456789abc"}
+	agent := domain.Agent{Key: domain.Key{PaneID: "p1", SessionDigest: tuple.Digest()}, Kind: "claude", Cwd: cwd}
+	r := newReader(func() (string, error) { return home, nil }, time.Now, nil)
+	r.session = func(context.Context, string) (domain.SessionTuple, error) { return tuple, nil }
+	dir := filepath.Join(home, ".claude", "projects", projectSlug(cwd))
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, tuple.Value+".jsonl")
+	if err := os.WriteFile(path, []byte("{\"type\":\"user\",\"message\":{\"content\":\"go\"}}\n{\"type\":\"assistant\",\"message\":{\"content\":\"Own full answer\"}}\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	sibling := filepath.Join(dir, "other.jsonl")
+	if err := os.WriteFile(sibling, []byte("{\"type\":\"user\",\"message\":{\"content\":\"unfinished sibling\"}}\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	future := time.Now().Add(time.Hour)
+	if err := os.Chtimes(sibling, future, future); err != nil {
+		t.Fatal(err)
+	}
+	reply, err := r.LastReply(context.Background(), agent)
+	if err != nil || reply.Text != "Own full answer" {
+		t.Fatalf("exact reply = %q, %v", reply.Text, err)
+	}
+	t.Run("changed session", func(t *testing.T) {
+		changed := agent
+		changed.SessionDigest = "different"
+		if _, err := r.LastReply(context.Background(), changed); !errors.Is(err, domain.ErrNoReply) {
+			t.Fatalf("changed identity = %v", err)
+		}
+	})
+	t.Run("missing exact file", func(t *testing.T) {
+		if err := os.Remove(path); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := r.LastReply(context.Background(), agent); !errors.Is(err, domain.ErrNoReply) {
+			t.Fatalf("missing transcript = %v", err)
+		}
+	})
+}
