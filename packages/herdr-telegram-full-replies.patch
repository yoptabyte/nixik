+func TestClaudeFinalMessageKeepsAllTextBlocks(t *testing.T) {
+	for _, identity := range []string{`"requestId":"final",`, `"messageID":"final",`} {
+		t.Run(identity, func(t *testing.T) {
+			request, message := `"requestId":"final",`, ""
+			if strings.HasPrefix(identity, `"messageID"`) {
+				request, message = "", `"id":"final",`
+			}
+			lines := []string{
+				`{"type":"user","message":{"content":"go"}}`,
+				`{"type":"assistant","requestId":"progress","message":{"id":"progress","content":[{"type":"text","text":"Earlier progress"}]}}`,
+				`{"type":"assistant",` + request + `"message":{` + message + `"content":[{"type":"text","text":"Answer begins"},{"type":"thinking","thinking":"private"},{"type":"text","text":"Answer middle"}]}}`,
+				`{"type":"assistant",` + request + `"message":{` + message + `"content":[{"type":"text","text":"Answer ends"}]}}`,
+			}
+			path := filepath.Join(t.TempDir(), "session.jsonl")
+			if err := os.WriteFile(path, []byte(strings.Join(lines, "\n")+"\n"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			text, _, _, err := lastReplyIn(path, defaultMaxScan)
+			if err != nil || text != "Answer begins\n\nAnswer middle\n\nAnswer ends" {
+				t.Fatalf("complete answer = %q, %v", text, err)
+			}
+		})
+	}
