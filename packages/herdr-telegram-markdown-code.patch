diff --git a/internal/adapters/system/git_files.go b/internal/adapters/system/git_files.go
--- /dev/null
+++ b/internal/adapters/system/git_files.go
@@ -0,0 +1,151 @@
+package system
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/permgps/herdr-telegram-agents/internal/domain"
+)
+
+// workingFiles reads current working-tree files, not blobs from HEAD. The git
+// listing excludes ignored untracked files. os.Root confines reads even when
+// a path component is a symlink; the nonblocking open also refuses special files.
+func (r *GitRunner) workingFiles(ctx context.Context, dir, sub, name string) (domain.GitResult, error) {
+	name = filepath.Clean(name)
+	if !filepath.IsLocal(name) {
+		return domain.GitResult{}, fmt.Errorf("use a path relative to the repository root")
+	}
+	for _, part := range strings.Split(filepath.ToSlash(name), "/") {
+		if strings.EqualFold(part, ".git") {
+			return domain.GitResult{}, fmt.Errorf("git metadata is not a source file")
+		}
+	}
+	bin, err := exec.LookPath(r.bin)
+	if err != nil {
+		return domain.GitResult{}, domain.ErrGitMissing
+	}
+	ctx, cancel := context.WithTimeout(ctx, r.timeout)
+	defer cancel()
+	query := func(where string, args ...string) ([]byte, bool, error) {
+		cmd := r.command(ctx, bin, where, gitArgv(args, nil))
+		out := &limitedWriter{max: r.maxBytes}
+		var stderr bytes.Buffer
+		cmd.Stdout, cmd.Stderr = out, &stderr
+		err := cmd.Run()
+		if ctx.Err() != nil {
+			return nil, false, ctx.Err()
+		}
+		if err != nil && !out.capped {
+			if strings.Contains(stderr.String(), "not a git repository") {
+				return nil, false, domain.ErrNotRepository
+			}
+			return nil, false, fmt.Errorf("git %s: %w: %s", args[0], err, firstLine(stderr.String()))
+		}
+		return out.buf.Bytes(), out.capped, nil
+	}
+	rootBytes, capped, err := query(dir, "rev-parse", "--show-toplevel")
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	if capped {
+		return domain.GitResult{}, fmt.Errorf("repository path exceeded the limit")
+	}
+	rootName := strings.TrimSuffix(string(rootBytes), "\n")
+	paths, capped, err := query(rootName, "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", ":(literal)"+filepath.ToSlash(name))
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	if capped {
+		paths = paths[:bytes.LastIndexByte(paths, 0)+1]
+	}
+	root, err := os.OpenRoot(rootName)
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	defer root.Close()
+	seen := map[string]bool{}
+	var names []string
+	for _, path := range strings.Split(string(paths), "\x00") {
+		if ctx.Err() != nil {
+			return domain.GitResult{}, ctx.Err()
+		}
+		if path == "" || seen[path] {
+			continue
+		}
+		seen[path] = true
+		if sub == "file" && path == filepath.ToSlash(name) {
+			return r.readWorkingFile(root, name)
+		}
+		// Deleted files and submodule/nested-repository directories are not code.
+		info, err := root.Lstat(path)
+		if err != nil || !info.Mode().IsRegular() {
+			continue
+		}
+		if strings.ContainsAny(path, "\n\r\t") {
+			path = strconv.Quote(path)
+		}
+		names = append(names, path)
+	}
+	if sub == "file" {
+		if capped {
+			return domain.GitResult{}, fmt.Errorf("file listing exceeded the limit; narrow the path")
+		}
+		return domain.GitResult{}, fmt.Errorf("file not found in tracked or non-ignored local files; use /git files")
+	}
+	sort.Strings(names)
+	return domain.GitResult{Output: strings.Join(names, "\n"), Truncated: capped}, nil
+}
+
+func (r *GitRunner) readWorkingFile(root *os.Root, name string) (domain.GitResult, error) {
+	parts := strings.Split(name, string(filepath.Separator))
+	for n := range parts {
+		info, err := root.Lstat(filepath.Join(parts[:n+1]...))
+		if err != nil {
+			return domain.GitResult{}, err
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return domain.GitResult{}, fmt.Errorf("symlinks cannot be viewed as source files")
+		}
+	}
+	f, err := root.OpenFile(name, os.O_RDONLY|fileOpenNonblock, 0)
+	if err != nil {
+		return domain.GitResult{}, fmt.Errorf("cannot open local file: %w", err)
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	if !info.Mode().IsRegular() {
+		return domain.GitResult{}, fmt.Errorf("only regular text files can be viewed")
+	}
+	data, err := io.ReadAll(io.LimitReader(f, int64(r.maxBytes)+1))
+	if err != nil {
+		return domain.GitResult{}, err
+	}
+	capped := len(data) > r.maxBytes
+	if capped {
+		data = data[:r.maxBytes]
+		// Do not turn a valid UTF-8 file into invalid text at the byte limit.
+		start := len(data)
+		for start > 0 && !utf8.RuneStart(data[start-1]) {
+			start--
+		}
+		if start > 0 && !utf8.FullRune(data[start-1:]) {
+			data = data[:start-1]
+		}
+	}
+	if !utf8.Valid(data) || bytes.IndexByte(data, 0) >= 0 {
+		return domain.GitResult{}, fmt.Errorf("binary files are not supported; choose a text source file")
+	}
+	return domain.GitResult{Output: string(data), Truncated: capped}, nil
+}
