+package system
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"unicode/utf8"
+)
+
+func TestGitWorkingFilesReadsCurrentCodeAndPreservesIndex(t *testing.T) {
+	dir := gitRepo(t)
+	write := func(name, data string) {
+		t.Helper()
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(data), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(".gitignore", "ignored.py\n")
+	write("ignored.py", "private\n")
+	if err := os.Mkdir(filepath.Join(dir, "src"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	write("src/new  file.py", "print('local only')\n\n  ")
+	cmd := exec.Command("git", "add", "a.txt")
+	cmd.Dir = dir
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("stage: %v: %s", err, out)
+	}
+	write("a.txt", "staged plus unstaged\n")
+	indexBefore, err := os.ReadFile(filepath.Join(dir, ".git/index"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := NewGitRunner(nil)
+	ctx := context.Background()
+	files, err := r.Run(ctx, filepath.Join(dir, "src"), []string{"files", "."})
+	if err != nil || !strings.Contains(files.Output, "a.txt") || !strings.Contains(files.Output, "src/new  file.py") || strings.Contains(files.Output, "ignored.py") {
+		t.Fatalf("files = %+v, %v", files, err)
+	}
+	filtered, err := r.Run(ctx, dir, []string{"files", "src"})
+	if err != nil || filtered.Output != "src/new  file.py" {
+		t.Fatalf("filtered = %+v, %v", filtered, err)
+	}
+	for name, want := range map[string]string{"a.txt": "staged plus unstaged\n", "src/new  file.py": "print('local only')\n\n  "} {
+		got, err := r.Run(ctx, filepath.Join(dir, "src"), []string{"file", name})
+		if err != nil || got.Output != want || got.Truncated {
+			t.Fatalf("%s = %+v, %v", name, got, err)
+		}
+	}
+	indexAfter, err := os.ReadFile(filepath.Join(dir, ".git/index"))
+	if err != nil || !bytes.Equal(indexBefore, indexAfter) {
+		t.Fatal("working file reads changed index")
+	}
+}
+
+func TestGitWorkingFilesRejectsUnsafeOrNonTextPaths(t *testing.T) {
+	dir := gitRepo(t)
+	outside := filepath.Join(t.TempDir(), "outside.py")
+	if err := os.WriteFile(outside, []byte("outside\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(dir, "escape.py")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(dir, ".git/config"), filepath.Join(dir, "metadata.py")); err != nil {
+		t.Fatal(err)
+	}
+	for name, data := range map[string][]byte{".gitignore": []byte("ignored.py\n"), "ignored.py": []byte("secret"), "binary": {0, 1, 2}, "utf8-invalid": {0xff}} {
+		if err := os.WriteFile(filepath.Join(dir, name), data, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	r := NewGitRunner(nil)
+	for _, name := range []string{"../outside.py", outside, ".git/config", "escape.py", "metadata.py", "ignored.py", "binary", "utf8-invalid", ".", "--help", ":(glob)*", "missing.py"} {
+		if got, err := r.Run(context.Background(), dir, []string{"file", name}); err == nil {
+			t.Fatalf("read %q = %+v", name, got)
+		}
+	}
+}
+
+func TestGitWorkingFileCapAndEmpty(t *testing.T) {
+	dir := gitRepo(t)
+	r := NewGitRunner(nil)
+	r.maxBytes = 128
+	if err := os.WriteFile(filepath.Join(dir, "text.py"), []byte(strings.Repeat("я", 100)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	got, err := r.Run(context.Background(), dir, []string{"file", "text.py"})
+	if err != nil || !got.Truncated || len(got.Output) != 128 || !utf8.ValidString(got.Output) {
+		t.Fatalf("utf8 cap = %+v, %v", got, err)
+	}
+	r.maxBytes = 129
+	got, err = r.Run(context.Background(), dir, []string{"file", "text.py"})
+	if err != nil || !got.Truncated || len(got.Output) != 128 || !utf8.ValidString(got.Output) {
+		t.Fatalf("partial utf8 = %+v, %v", got, err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "empty.py"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	got, err = r.Run(context.Background(), dir, []string{"file", "empty.py"})
+	if err != nil || got.Output != "" || got.Truncated {
+		t.Fatalf("empty file = %+v, %v", got, err)
+	}
+}
