diff --git a/internal/app/git_markdown.go b/internal/app/git_markdown.go
--- /dev/null
+++ b/internal/app/git_markdown.go
@@ -0,0 +1,64 @@
+package app
+
+import (
+	"path/filepath"
+	"strings"
+
+	"github.com/permgps/herdr-telegram-agents/internal/domain"
+)
+
+func gitMarkdown(spec domain.GitSpec, out string, truncated bool) string {
+	title, language, note := "Local diff", "diff", "Changes in the local working tree against HEAD."
+	if len(spec.Args) == 4 && spec.Args[1] == "--merge-base" {
+		note = "Local changes since the upstream merge base (tracking reference from the last git fetch); includes local commits, staged/unstaged changes and non-ignored untracked files."
+	} else if len(spec.Args) == 2 && spec.Args[1] == "--cached" {
+		note = "Staged changes against HEAD."
+	} else if spec.Sub == "file" {
+		title, note, language = "Local source file", "Current contents on this computer, including unpushed and uncommitted edits.", ""
+		if len(spec.Args) == 2 {
+			language = sourceLanguage(spec.Args[1])
+		}
+	}
+	var b strings.Builder
+	b.WriteString("# " + title + "\n\n" + note + "\n\n")
+	if spec.Sub == "file" && len(spec.Args) == 2 {
+		b.WriteString("Repository-relative path:\n\n" + markdownCode(spec.Args[1], "text") + "\n")
+	}
+	if truncated {
+		b.WriteString("> Output truncated at the size limit. This is a partial view.\n\n")
+	}
+	if out == "" && spec.Sub != "file" {
+		b.WriteString("No changes.\n")
+		return b.String()
+	}
+	b.WriteString(markdownCode(out, language))
+	return b.String()
+}
+
+// A fence longer than every backtick run keeps embedded Markdown/code intact.
+func markdownCode(text, language string) string {
+	longest, run := 2, 0
+	for _, c := range text {
+		if c == '`' {
+			run++
+			longest = max(longest, run)
+		} else {
+			run = 0
+		}
+	}
+	fence := strings.Repeat("`", longest+1)
+	if text != "" && !strings.HasSuffix(text, "\n") {
+		text += "\n"
+	}
+	return fence + language + "\n" + text + fence + "\n"
+}
+
+func sourceLanguage(name string) string {
+	languages := map[string]string{
+		".go": "go", ".py": "python", ".js": "javascript", ".jsx": "jsx", ".ts": "typescript", ".tsx": "tsx",
+		".nix": "nix", ".rs": "rust", ".php": "php", ".sh": "bash", ".bash": "bash", ".json": "json",
+		".yaml": "yaml", ".yml": "yaml", ".toml": "toml", ".html": "html", ".css": "css", ".sql": "sql",
+		".md": "markdown", ".c": "c", ".h": "c", ".cpp": "cpp", ".java": "java", ".rb": "ruby",
+	}
+	return languages[strings.ToLower(filepath.Ext(name))]
+}
