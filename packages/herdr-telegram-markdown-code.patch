+package domain_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/permgps/herdr-telegram-agents/internal/domain"
+)
+
+func TestParseGitMarkdownAndFiles(t *testing.T) {
+	for _, words := range [][]string{{"diff", "md"}, {"diff", "staged", "md"}, {"diff", "remote", "md"}} {
+		base, ok := domain.ParseGit(words[:len(words)-1])
+		got, accepted := domain.ParseGit(words)
+		if !ok || !accepted || !got.Markdown || !reflect.DeepEqual(got.Args, base.Args) {
+			t.Fatalf("%v = %+v, %v", words, got, accepted)
+		}
+	}
+	for _, words := range [][]string{{"diff", "md", "md"}, {"diff", "remote", "--stat", "md"}, {"file"}, {"diff", "md", "remote"}} {
+		if _, ok := domain.ParseGit(words); ok {
+			t.Fatalf("accepted %v", words)
+		}
+	}
+	cmd := domain.ParseCommand("/git file src/my  file.py", "bot")
+	if cmd.Kind != domain.CmdGit || !cmd.Git.Markdown || !reflect.DeepEqual(cmd.Git.Args, []string{"file", "src/my  file.py"}) {
+		t.Fatalf("file command = %+v", cmd)
+	}
+	spec, ok := domain.ParseGit([]string{"files"})
+	if !ok || !reflect.DeepEqual(spec.Args, []string{"files", "."}) {
+		t.Fatalf("files = %+v", spec)
+	}
+}
